# Copy to .env and fill in. .env is gitignored; .env.example is not.

# --- Postgres ---
POSTGRES_USER=spendly
POSTGRES_PASSWORD=spendly
POSTGRES_DB=spendly

# --- Service datasources ---
# One logical database per service (CLAUDE.md 6.1). These apply when a service runs on the
# host (./mvnw spring-boot:run); the containers in docker-compose.yml point at the compose
# network instead and need nothing from here. application.yaml carries no credential
# defaults on purpose, so the user/password must be set for a host-run service to start.
SPENDLY_USER_DB_URL=jdbc:postgresql://localhost:5432/spendly_user
SPENDLY_ACCOUNT_DB_URL=jdbc:postgresql://localhost:5432/spendly_account
SPENDLY_TRANSACTION_DB_URL=jdbc:postgresql://localhost:5432/spendly_transaction
SPENDLY_BUDGET_DB_URL=jdbc:postgresql://localhost:5432/spendly_budget
SPENDLY_RECURRING_DB_URL=jdbc:postgresql://localhost:5432/spendly_recurring
SPENDLY_IMPORT_DB_URL=jdbc:postgresql://localhost:5432/spendly_import
SPENDLY_DB_USER=spendly
SPENDLY_DB_PASSWORD=spendly
# The `iss` claim auth-service signs into every token and the value every service validates it against.
SPENDLY_OIDC_ISSUER=http://localhost:8096
# Host-run services reach the broker on its host listener; containers use kafka:19092.
SPENDLY_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# poller = each service ships its own outbox_event rows; cdc = Debezium does (needs
# `docker compose --profile cdc up -d`). In compose this reaches the containers.
SPENDLY_OUTBOX_MODE=poller
# Redis backs the gateway's per-subject rate limit and transaction-service's category cache.
SPENDLY_REDIS_URL=redis://localhost:6379

# --- Platform (FI-32, FI-33, FI-34) ---
# Eureka and the config server are optional at runtime: a service that cannot reach them
# keeps its packaged defaults and resolves siblings by DNS. The containers set these to the
# compose names; these values apply to a service run from the host.
SPENDLY_EUREKA_ENABLED=false
SPENDLY_EUREKA_URL=http://localhost:8761/eureka/
SPENDLY_CONFIG_SERVER_URL=http://localhost:8888
# Requests per subject per minute at the gateway.
SPENDLY_RATE_LIMIT_PER_MINUTE=300
# --- Demo data ---
# dev@spendly.local starts with accounts, a ledger, budgets and recurring rules so no screen
# is ever empty. Every service seeds its own slice from common.demo.DemoData; it is idempotent
# and never runs in a deployed profile.
SPENDLY_DEMO_DATA=true
# true wipes the demo owner's rows first — use it after changing MONTHS or SCALE.
SPENDLY_DEMO_DATA_RESET=false
# Months of history, ending with the current month (1-36).
SPENDLY_DEMO_DATA_MONTHS=4
# Percentage applied to every amount: 100 as written, 250 for two and a half times (1-1000).
SPENDLY_DEMO_DATA_SCALE=100

# import-service: MinIO credentials (the same as the MinIO root user below).
SPENDLY_STORAGE_ACCESS_KEY=spendly
SPENDLY_STORAGE_SECRET_KEY=spendly-minio

# --- Sign-in (auth-service) ---
# Seals the TOTP secrets and the token signing key at rest: 32 random bytes, base64. The compose
# file carries a local-only default; generate your own anywhere that holds real accounts:
#   openssl rand -base64 32
SPENDLY_AUTH_ENCRYPTION_KEY=

# --- Sign in with Google ---
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add this authorised redirect URI:
#   http://localhost:8081/api/v1/auth/google/callback
# Leave both empty to run without Google: the button is then not shown.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- MinIO ---
MINIO_ROOT_USER=spendly
MINIO_ROOT_PASSWORD=spendly-minio

# --- Host port mappings ---
# Defaults are the conventional ports. Override any that collide with another
# project already running on this machine (docker compose will refuse to start
# otherwise). Container-internal ports never change.
POSTGRES_PORT=5432
AUTH_SERVICE_PORT=8096
AUTH_SERVICE_MANAGEMENT_PORT=9096
# Platform services. The browser talks to the gateway only (CLAUDE.md 3), so changing
# API_GATEWAY_PORT also means changing frontend/src/environments/environment.ts.
API_GATEWAY_PORT=8081
# 9081 inside the container; 9082 on the host, because 9081 is free but 9081+1 keeps the
# 9000+(port-8000) rule readable next to the other management ports.
API_GATEWAY_MANAGEMENT_PORT=9082
DISCOVERY_SERVER_PORT=8761
DISCOVERY_SERVER_MANAGEMENT_PORT=9761
CONFIG_SERVER_PORT=8888
CONFIG_SERVER_MANAGEMENT_PORT=9888
# Application containers. The frontend bundle is wired to 4200 / 8082, so changing these
# also means changing those.
FRONTEND_PORT=4200
USER_SERVICE_PORT=8082
USER_SERVICE_MANAGEMENT_PORT=9091
ACCOUNT_SERVICE_PORT=8083
ACCOUNT_SERVICE_MANAGEMENT_PORT=9083
TRANSACTION_SERVICE_PORT=8084
TRANSACTION_SERVICE_MANAGEMENT_PORT=9084
BUDGET_SERVICE_PORT=8085
BUDGET_SERVICE_MANAGEMENT_PORT=9085
RECURRING_SERVICE_PORT=8087
RECURRING_SERVICE_MANAGEMENT_PORT=9087
GOAL_SERVICE_PORT=8086
GOAL_SERVICE_MANAGEMENT_PORT=9086
# notification-service sits on 9191: 9091 belongs to user-service, which predates the 9000 + (port - 8000) rule.
NOTIFICATION_SERVICE_PORT=8091
NOTIFICATION_SERVICE_MANAGEMENT_PORT=9191
IMPORT_SERVICE_PORT=8088
IMPORT_SERVICE_MANAGEMENT_PORT=9088
ANALYTICS_SERVICE_PORT=8090
# Prometheus already owns 9090 on the host, so the management port is published on 9089.
ANALYTICS_SERVICE_MANAGEMENT_PORT=9089
SHARING_SERVICE_PORT=8093
SHARING_SERVICE_MANAGEMENT_PORT=9093
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
KAFKA_PORT=9092
# 8081 inside the container; 8094 on the host, because the gateway already owns 8081.
SCHEMA_REGISTRY_PORT=8094
DEBEZIUM_CONNECT_PORT=8095
KAFKA_UI_PORT=8099
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
TEMPO_PORT=3200

# --- Grafana ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- Web push (notification-service) ---
# A stable VAPID key pair lets a browser keep its push subscription across restarts. Leave both empty
# and the service generates an ephemeral pair at startup (subscriptions made before a restart then stop
# working). Generate a pair with:  npx web-push generate-vapid-keys
SPENDLY_VAPID_PUBLIC_KEY=
SPENDLY_VAPID_PRIVATE_KEY=
