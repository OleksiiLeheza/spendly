# Copy to .env and fill in. .env is gitignored; .env.example is not.

# --- Postgres ---
POSTGRES_USER=spendly
POSTGRES_PASSWORD=spendly
POSTGRES_DB=spendly

# --- Service datasources ---
# One logical database per service (CLAUDE.md 6.1). These apply when a service runs on the
# host (./mvnw spring-boot:run); the containers in docker-compose.yml point at the compose
# network instead and need nothing from here. application.yaml carries no credential
# defaults on purpose, so the user/password must be set for a host-run service to start.
SPENDLY_USER_DB_URL=jdbc:postgresql://localhost:5432/spendly_user
SPENDLY_ACCOUNT_DB_URL=jdbc:postgresql://localhost:5432/spendly_account
SPENDLY_TRANSACTION_DB_URL=jdbc:postgresql://localhost:5432/spendly_transaction
SPENDLY_DB_USER=spendly
SPENDLY_DB_PASSWORD=spendly
# Must match KEYCLOAK_PORT below: it is both the `iss` claim Keycloak mints and the value
# every service validates against.
SPENDLY_OIDC_ISSUER=http://localhost:8080/realms/spendly

# --- Keycloak admin console (http://localhost:8080) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Google social login (FI-10) ---
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI:
#   http://localhost:8080/realms/spendly/broker/google/endpoint
# Leave the placeholders as-is to bring the stack up without Google; the button will
# appear on the login page but fail until real credentials are set.
GOOGLE_CLIENT_ID=google-client-id-not-set
GOOGLE_CLIENT_SECRET=google-client-secret-not-set

# --- MinIO ---
MINIO_ROOT_USER=spendly
MINIO_ROOT_PASSWORD=spendly-minio

# --- Host port mappings ---
# Defaults are the conventional ports. Override any that collide with another
# project already running on this machine (docker compose will refuse to start
# otherwise). Container-internal ports never change.
POSTGRES_PORT=5432
KEYCLOAK_PORT=8080
# Application containers. The frontend bundle and the Keycloak realm (redirect URIs, CORS)
# are wired to 4200 / 8082, so changing these also means changing those.
FRONTEND_PORT=4200
USER_SERVICE_PORT=8082
USER_SERVICE_MANAGEMENT_PORT=9091
ACCOUNT_SERVICE_PORT=8083
ACCOUNT_SERVICE_MANAGEMENT_PORT=9083
TRANSACTION_SERVICE_PORT=8084
TRANSACTION_SERVICE_MANAGEMENT_PORT=9084
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
KAFKA_PORT=9092
KAFKA_UI_PORT=8099
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
TEMPO_PORT=3200

# --- Grafana ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
