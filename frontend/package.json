{
  "name": "spendly-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\" \"e2e/**/*.ts\"",
    "i18n:check": "node scripts/check-i18n.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "api:generate:auth": "openapi-generator-cli generate -i ${AUTH_API_DOCS_URL:-http://localhost:8096/v3/api-docs} -g typescript-angular -o src/app/core/api/auth --additional-properties=ngVersion=22.1.0,providedInRoot=true,withInterfaces=true,fileNaming=kebab-case,serviceSuffix=Api,useSingleRequestParameter=false,supportsES6=true",
    "api:generate:user": "openapi-generator-cli generate -i ${USER_API_DOCS_URL:-http://localhost:8082/v3/api-docs} -g typescript-angular -o src/app/core/api/user --additional-properties=ngVersion=22.1.0,providedInRoot=true,withInterfaces=true,fileNaming=kebab-case,serviceSuffix=Api,useSingleRequestParameter=false,supportsES6=true",
    "api:generate:account": "openapi-generator-cli generate -i ${ACCOUNT_API_DOCS_URL:-http://localhost:8083/v3/api-docs} -g typescript-angular -o src/app/core/api/account --additional-properties=ngVersion=22.1.0,providedInRoot=true,withInterfaces=true,fileNaming=kebab-case,serviceSuffix=Api,useSingleRequestParameter=false,supportsES6=true",
    "api:generate:transaction": "openapi-generator-cli generate -i ${TRANSACTION_API_DOCS_URL:-http://localhost:8084/v3/api-docs} -g typescript-angular -o src/app/core/api/transaction --additional-properties=ngVersion=22.1.0,providedInRoot=true,withInterfaces=true,fileNaming=kebab-case,serviceSuffix=Api,useSingleRequestParameter=false,supportsES6=true",
    "api:generate:budget": "openapi-generator-cli generate -i ${BUDGET_API_DOCS_URL:-http://localhost:8085/v3/api-docs} -g typescript-angular -o src/app/core/api/budget --additional-properties=ngVersion=22.1.0,providedInRoot=true,withInterfaces=true,fileNaming=kebab-case,serviceSuffix=Api,useSingleRequestParameter=false,supportsES6=true",
    "api:generate:recurring": "openapi-generator-cli generate -i ${RECURRING_API_DOCS_URL:-http://localhost:8087/v3/api-docs} -g typescript-angular -o src/app/core/api/recurring --additional-properties=ngVersion=22.1.0,providedInRoot=true,withInterfaces=true,fileNaming=kebab-case,serviceSuffix=Api,useSingleRequestParameter=false,supportsES6=true",
    "api:generate:import": "openapi-generator-cli generate -i ${IMPORT_API_DOCS_URL:-http://localhost:8088/v3/api-docs} -g typescript-angular -o src/app/core/api/import --additional-properties=ngVersion=22.1.0,providedInRoot=true,withInterfaces=true,fileNaming=kebab-case,serviceSuffix=Api,useSingleRequestParameter=false,supportsES6=true",
    "api:generate:goal": "openapi-generator-cli generate -i ${GOAL_API_DOCS_URL:-http://localhost:8086/v3/api-docs} -g typescript-angular -o src/app/core/api/goal --additional-properties=ngVersion=22.1.0,providedInRoot=true,withInterfaces=true,fileNaming=kebab-case,serviceSuffix=Api,useSingleRequestParameter=false,supportsES6=true",
    "api:generate:notification": "openapi-generator-cli generate -i ${NOTIFICATION_API_DOCS_URL:-http://localhost:8091/v3/api-docs} -g typescript-angular -o src/app/core/api/notification --additional-properties=ngVersion=22.1.0,providedInRoot=true,withInterfaces=true,fileNaming=kebab-case,serviceSuffix=Api,useSingleRequestParameter=false,supportsES6=true",
    "api:generate:analytics": "openapi-generator-cli generate -i ${ANALYTICS_API_DOCS_URL:-http://localhost:8090/v3/api-docs} -g typescript-angular -o src/app/core/api/analytics --additional-properties=ngVersion=22.1.0,providedInRoot=true,withInterfaces=true,fileNaming=kebab-case,serviceSuffix=Api,useSingleRequestParameter=false,supportsES6=true",
    "api:generate:sharing": "openapi-generator-cli generate -i ${SHARING_API_DOCS_URL:-http://localhost:8093/v3/api-docs} -g typescript-angular -o src/app/core/api/sharing --additional-properties=ngVersion=22.1.0,providedInRoot=true,withInterfaces=true,fileNaming=kebab-case,serviceSuffix=Api,useSingleRequestParameter=false,supportsES6=true",
    "api:generate": "npm run api:generate:auth && npm run api:generate:user && npm run api:generate:account && npm run api:generate:transaction && npm run api:generate:budget && npm run api:generate:recurring && npm run api:generate:import && npm run api:generate:goal && npm run api:generate:notification && npm run api:generate:analytics && npm run api:generate:sharing"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.7",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@jsverse/transloco": "^8.4.0",
    "@jsverse/transloco-messageformat": "^8.4.0",
    "@ngrx/signals": "^22.0.1",
    "decimal.js": "^10.6.0",
    "echarts": "^6.1.0",
    "ngx-echarts": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@playwright/test": "^1.63.0",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true
  }
}
