<?xml version="1.0" encoding="UTF-8"?>
<!--
  Every entry here is a deliberate exception with a stated reason. An exclusion without a
  justification is a bug that was hidden rather than fixed.
-->
<FindBugsFilter>

    <!--
      CSRF protection is disabled on purpose. The API is stateless and token-based: the
      browser holds the access token in memory and sends it in an Authorization header
      (CLAUDE.md 8). There is no cookie or other ambient credential for a cross-site request
      to ride on, which is the only thing CSRF tokens defend against. Re-enable this the day
      any endpoint starts accepting cookie authentication.
    -->
    <Match>
        <Class name="~com\.spendly\.[a-z]+service\.config\.SecurityConfig"/>
        <Bug pattern="SPRING_CSRF_PROTECTION_DISABLED"/>
    </Match>

    <!--
      BaseEntity.equals resolves the Hibernate proxy's persistent class on both sides and
      compares those before casting, so a foreign argument returns false rather than
      throwing. SpotBugs cannot see through the helper method that does the unwrapping.
    -->
    <Match>
        <Class name="com.spendly.common.persistence.BaseEntity"/>
        <Method name="equals"/>
        <Bug pattern="BC_EQUALS_METHOD_SHOULD_WORK_FOR_ALL_OBJECTS"/>
    </Match>

    <!--
      A domain aggregate hands out references to its own entities on purpose: a Posting
      exposes the Account it belongs to, and TransferLegs is the pair of Postings the
      invariant was checked on. JPA-managed entities are mutable by definition; what governs
      their mutation is the service-method transaction boundary (CLAUDE.md 6.15), not a
      defensive copy that Hibernate would not track anyway.
    -->
    <Match>
        <Package name="~com\.spendly\.[a-z]+service\.domain"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!--
      Request and response records in api.dto are transport values. Jackson builds a fresh
      List for every request body and MapStruct builds a fresh one for every response, and
      nothing holds a reference afterwards, so a defensive copy would copy a list nobody
      else can reach. Service-level result records (PostedTransaction) hand back the entity
      the transaction just produced for the same reason as the domain exclusion above.
    -->
    <Match>
        <Or>
            <Package name="~com\.spendly\.[a-z]+service\.api\.dto"/>
            <Class name="com.spendly.transactionservice.service.PostedTransaction"/>
        </Or>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!--
      Constructor injection stores the container-managed ObjectMapper; it is shared by
      design and never mutated here.
    -->
    <Match>
        <Class name="com.spendly.transactionservice.service.CategorySeeds"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!--
      These log lines carry UUIDs and a language code already normalised to "en" or "uk";
      neither can contain a CRLF, and deployed profiles emit JSON logs (CLAUDE.md 11).
    -->
    <Match>
        <Or>
            <And>
                <Class name="com.spendly.transactionservice.service.CategoryService"/>
                <Method name="merge"/>
            </And>
            <And>
                <Class name="com.spendly.transactionservice.service.CategorySeeder"/>
                <Method name="seed"/>
            </And>
        </Or>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <!--
      Partition DDL has to interpolate the table name: PostgreSQL does not accept a bind
      parameter there. The name is built from a YearMonth's two integers by a fixed format
      string, so no caller-supplied text ever reaches the statement.
    -->
    <Match>
        <Class name="com.spendly.transactionservice.repository.TransactionPartitions"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC,SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE,SQL_INJECTION_JDBC"/>
    </Match>

    <!--
      The reconciliation warning logs an account UUID and two Money values. UUID.toString and
      Money.toString (ISO code + plain decimal) cannot carry a CRLF, and deployed profiles emit
      JSON logs where the encoder escapes control characters regardless (CLAUDE.md 11).
    -->
    <Match>
        <Class name="com.spendly.accountservice.service.AccountService"/>
        <Method name="reconcile"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <!--
      EI_EXPOSE_REP / EI_EXPOSE_REP2 warn about handing out or storing a mutable object without
      a defensive copy. That is sound advice for value objects and is irrelevant to Spring
      beans: a constructor-injected collaborator (CLAUDE.md 12, constructor injection only) is
      a shared singleton by design, and copying it would be a bug. Value objects in this code
      base are records, which the detector does not flag.
    -->
    <Match>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
        <Or>
            <Package name="~com\.spendly\..*\.service"/>
            <Package name="~com\.spendly\..*\.api"/>
            <Package name="~com\.spendly\..*\.config"/>
            <Package name="~com\.spendly\.common\.autoconfigure"/>
        </Or>
    </Match>

</FindBugsFilter>
