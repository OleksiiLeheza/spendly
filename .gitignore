### Maven / build output ###
# No leading slash: also catches module builds like user-service/target/
target/
build/
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/
dependency-reduced-pom.xml
.flattened-pom.xml
release.properties
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
buildNumber.properties

### Maven wrapper ###
# wrapperVersion 3.3.4 uses distributionType=only-script, so no jar is checked in
.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

